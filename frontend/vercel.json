{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://jaktra.site https://images.unsplash.com; connect-src 'self' https://jaktra-backend.onrender.com https://api.razorpay.com https://lumberjack.razorpay.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/(invite|i)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/compare/highradius-alternative",
      "destination": "/compare/highradius-vs-jaktra",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jaktra-backend.onrender.com/api/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://jaktra-backend.onrender.com/public/:path*"
    },
    {
      "source": "/(invoices|agent|analytics|dlq|disputes|payment-plans|settings|activity-log|invite|i)/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(invoices|agent|analytics|dlq|disputes|payment-plans|settings|activity-log|invite|i)",
      "destination": "/index.html"
    }
  ]
}
